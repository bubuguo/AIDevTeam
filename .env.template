# --- LLM endpoint (any OpenAI-compatible vendor: NIM, Ollama, vLLM, ...) ---
# LLM_BASE_URL and LLM_MODEL are required; LLM_API_KEY only for authenticated endpoints.
LLM_BASE_URL=<llm_url>
LLM_MODEL=<llm_model>
LLM_API_KEY=<llm_key>

# Required: the GitHub issue number is the canonical issue_id for each run.
GITHUB_TOKEN=<github_token>
GITHUB_OWNER=<github_owner>
GITHUB_REPO=<github_repo>
